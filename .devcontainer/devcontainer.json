{
  "name": "WordPress Dev Environment",

  // Backed by docker-compose so the WordPress (Apache/PHP) and MariaDB
  // services run as siblings to the dev container. Claude Code lives in the
  // `dev` service; it edits the shared webroot bind mount and talks to `db`
  // and `wordpress` over the compose network.
  //
  // Two files: the base stack + docker-compose.override.yml (the active profile
  // overlay, written by bin/use-profile.sh — empty for plain WordPress). Compose
  // merges them; listing the override here mirrors `docker compose`'s own
  // auto-merge of that filename.
  "dockerComposeFile": ["../docker-compose.yml", "../docker-compose.override.yml"],
  "service": "dev",
  "workspaceFolder": "/workspace",

  // Bring up the whole stack when the devcontainer starts.
  "runServices": ["dev", "wordpress", "db", "adminer", "mailpit"],

  // NET_ADMIN/NET_RAW are required by init-firewall.sh. The firewall is what
  // makes `claude --dangerously-skip-permissions` safe: even a
  // prompt-injected agent can only reach the allowlisted domains + the
  // compose network, so it cannot exfiltrate to arbitrary hosts.
  "capAdd": ["NET_ADMIN", "NET_RAW"],

  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "bmewburn.vscode-intelephense-client",
        "esbenp.prettier-vscode",
        "eamodio.gitlens"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "zsh",
        "terminal.integrated.profiles.linux": {
          "bash": { "path": "bash", "icon": "terminal-bash" },
          "zsh": { "path": "zsh" }
        }
      }
    }
  },

  "remoteUser": "node",

  "mounts": [
    "source=wpdev-bashhistory-${devcontainerId},target=/commandhistory,type=volume",
    "source=wpdev-claude-config-${devcontainerId},target=/home/node/.claude,type=volume"
  ],

  "containerEnv": {
    "NODE_OPTIONS": "--max-old-space-size=4096",
    "CLAUDE_CONFIG_DIR": "/home/node/.claude",
    "POWERLEVEL9K_DISABLE_GITSTATUS": "true"
  },

  "postCreateCommand": "bash .devcontainer/bake-plugins.sh && node .devcontainer/configure-claude-settings.js \"$(command -v node)\" && bash scripts/bootstrap-wp.sh",
  "postStartCommand": "sudo /usr/local/bin/init-firewall.sh",
  "waitFor": "postStartCommand"
}
