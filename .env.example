# Copy to .env. Compose reads this automatically.

# Per-site identity. Drives the Docker volume + network names.
PROJECT_NAME=wpsite

# Which profile is active (set by bin/use-profile.sh — this is a record for
# humans; the source of truth is docker-compose.override.yml). none | civicrm
PROFILE=none

# Production site URL (used by scripts/import-site.sh search-replace; optional).
PROD_URL=https://example.org

# Timezone for the containers.
TZ=America/Vancouver

# Host ports. Change these if the defaults are taken or you run two sites at once.
WEB_PORT=8090       # WordPress (Apache)      -> http://localhost:8090
ADMINER_PORT=8091   # Adminer DB UI           -> http://localhost:8091
DB_PORT=13307       # MariaDB (host access)
MAILPIT_PORT=8035   # Mailpit mail-catcher UI -> http://localhost:8035

# WordPress auto-install (scripts/bootstrap-wp.sh runs `wp core install` first boot).
WP_URL=http://localhost:8090
WP_TITLE=WordPress Dev
WP_ADMIN_USER=admin
WP_ADMIN_PASS=admin
WP_ADMIN_EMAIL=admin@example.com

# Optional: only needed if you drive Claude Code via API key instead of login.
# The firewall allows api.anthropic.com regardless.
# ANTHROPIC_API_KEY=
